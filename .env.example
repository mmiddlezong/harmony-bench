# Copy to .env and fill in the keys you have. Models without a key are skipped.
# .env is gitignored.

# Anthropic (Claude). Required: models without their key env var set are skipped.
ANTHROPIC_API_KEY=

# OpenAI (GPT-6 family). Also needed for the judge (GPT-6 Luna), which grades every answer.
OPENAI_API_KEY=

# Google Gemini API / AI Studio (GOOGLE_API_KEY also works)
GEMINI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# OpenRouter (open-weight models)
OPENROUTER_API_KEY=
